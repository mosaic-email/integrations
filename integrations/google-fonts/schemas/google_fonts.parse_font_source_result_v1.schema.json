{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "fonts"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "catalog" },
        "fonts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["id", "family", "category", "weights", "styles", "subsets", "variable", "lastModified", "supported"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 100 },
              "family": { "type": "string", "minLength": 1, "maxLength": 100 },
              "category": { "type": "string", "enum": ["display", "handwriting", "icons", "monospace", "sans-serif", "serif"] },
              "weights": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "type": "integer", "minimum": 100, "maximum": 900 } },
              "styles": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "enum": ["normal", "italic"] } },
              "subsets": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
              "variable": { "type": "boolean" },
              "lastModified": { "type": "string", "minLength": 10, "maxLength": 10 },
              "supported": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "id", "family", "variants"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "selection" },
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "family": { "type": "string", "minLength": 1, "maxLength": 100 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["weight", "style"],
            "additionalProperties": false,
            "properties": {
              "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
              "style": { "type": "string", "enum": ["normal", "italic"] }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "faces"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "css" },
        "faces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["sourceUrl", "weight", "style", "format"],
            "additionalProperties": false,
            "properties": {
              "sourceUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
              "style": { "type": "string", "enum": ["normal", "italic"] },
              "format": { "type": "string", "enum": ["woff", "woff2"] }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "code"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "error" },
        "code": {
          "type": "string",
          "enum": [
            "GOOGLE_FONT_CATALOG_INVALID",
            "GOOGLE_FONT_SELECTION_INVALID",
            "GOOGLE_FONT_SELECTION_UNSUPPORTED",
            "GOOGLE_FONT_CSS_INVALID",
            "GOOGLE_FONT_CSS_UNSUPPORTED",
            "GOOGLE_FONT_RESOURCE_INVALID"
          ]
        }
      }
    }
  ]
}

