{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceChecksum",
    "emailId",
    "emailLibraryId",
    "purpose",
    "dynamicModuleEmission",
    "profile",
    "modules",
    "personalization",
    "scalarUsages",
    "rasterRegions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "emailformat-sfmc-provider-plan-request-v1"
    },
    "sourceChecksum": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "emailId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "emailLibraryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "enum": [
        "authoring-preview",
        "recipient-output"
      ]
    },
    "dynamicModuleEmission": {
      "type": "boolean"
    },
    "profile": {
      "type": "object",
      "required": [
        "schemaVersion",
        "tokenCatalog",
        "variableBinding",
        "moduleVariations",
        "configurationCapabilities",
        "connectedOperations",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": "emailformat-profile-v1"
        },
        "tokenCatalog": {
          "type": "object",
          "required": [
            "delimiter",
            "entries",
            "authoredEmission"
          ],
          "properties": {
            "delimiter": {
              "type": "object",
              "required": [
                "id",
                "opener",
                "closer",
                "active"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "opener": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "closer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "active": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "entries": {
              "type": "array",
              "maxItems": 160,
              "items": {
                "type": "object",
                "required": [
                  "rawToken",
                  "friendlyName"
                ],
                "properties": {
                  "rawToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "friendlyName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "additionalProperties": false
              }
            },
            "authoredEmission": {
              "const": "inert-only"
            }
          },
          "additionalProperties": false
        },
        "variableBinding": {
          "type": "object",
          "required": [
            "syntax",
            "attributeNamePattern",
            "typedUsageTypes"
          ],
          "properties": {
            "syntax": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "attributeNamePattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "typedUsageTypes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "enum": [
                  "string"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "moduleVariations": {
          "type": "object",
          "required": [
            "conditionValueTypes",
            "conditionOperators",
            "conditionGroups",
            "applicationScopes",
            "outputSurfaces",
            "fallbackBehaviors",
            "branchOrder",
            "nestedSemantics"
          ],
          "properties": {
            "conditionValueTypes": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "enum": [
                  "text",
                  "number"
                ]
              }
            },
            "conditionOperators": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "starts-with",
                  "ends-with",
                  "is-empty",
                  "is-not-empty",
                  "greater-than",
                  "greater-than-or-equal",
                  "less-than",
                  "less-than-or-equal"
                ]
              }
            },
            "conditionGroups": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "enum": [
                  "and",
                  "or"
                ]
              }
            },
            "applicationScopes": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "const": "module"
              }
            },
            "outputSurfaces": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "enum": [
                  "html",
                  "text"
                ]
              }
            },
            "fallbackBehaviors": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "enum": [
                  "show",
                  "hide"
                ]
              }
            },
            "branchOrder": {
              "const": "saved-array-first-match"
            },
            "nestedSemantics": {
              "const": "ancestor-and"
            }
          },
          "additionalProperties": false
        },
        "configurationCapabilities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "connectedOperations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "instanceId"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "fallbackBehavior": {
            "enum": [
              "show",
              "hide"
            ]
          },
          "variations": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "variationId",
                "segmentId",
                "segmentName",
                "condition"
              ],
              "properties": {
                "variationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "parentVariationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "segmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "segmentName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "condition": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "operator",
                        "children"
                      ],
                      "properties": {
                        "kind": {
                          "const": "group"
                        },
                        "operator": {
                          "enum": [
                            "and",
                            "or"
                          ]
                        },
                        "children": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "items": {
                            "type": "object"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "id",
                        "binding",
                        "operator",
                        "value"
                      ],
                      "properties": {
                        "kind": {
                          "const": "comparison"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "binding": {
                          "type": "object",
                          "required": [
                            "variableId",
                            "definitionVersion",
                            "bindingVersion",
                            "attributeName"
                          ],
                          "properties": {
                            "variableId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160
                            },
                            "definitionVersion": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "bindingVersion": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "attributeName": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          },
                          "additionalProperties": false
                        },
                        "operator": {
                          "enum": [
                            "equals",
                            "not-equals",
                            "contains",
                            "not-contains",
                            "starts-with",
                            "ends-with",
                            "is-empty",
                            "is-not-empty",
                            "greater-than",
                            "greater-than-or-equal",
                            "less-than",
                            "less-than-or-equal"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 256
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "personalization": {
      "type": "object",
      "required": [
        "valid",
        "schemaVersion",
        "libraryId",
        "variables"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "schemaVersion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "libraryId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "variables": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "status",
                  "definitionCount",
                  "bindings"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "status": {
                    "enum": [
                      "active",
                      "retired"
                    ]
                  },
                  "definitionCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "bindings": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "version",
                        "definitionVersion",
                        "attributeName"
                      ],
                      "properties": {
                        "version": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "definitionVersion": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "attributeName": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "scalarUsages": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "usageId",
          "variableId",
          "definitionVersion",
          "bindingVersion",
          "fallback"
        ],
        "properties": {
          "usageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "variableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "definitionVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "bindingVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "fallback": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000000
          }
        },
        "additionalProperties": false
      }
    },
    "rasterRegions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "regionId",
          "moduleInstanceIds",
          "states"
        ],
        "properties": {
          "regionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "moduleInstanceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "stateId",
                "selection"
              ],
              "properties": {
                "stateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "selection": {
                  "type": "array",
                  "maxItems": 512,
                  "items": {
                    "type": "object",
                    "required": [
                      "moduleInstanceId",
                      "variationId"
                    ],
                    "properties": {
                      "moduleInstanceId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "variationId": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
