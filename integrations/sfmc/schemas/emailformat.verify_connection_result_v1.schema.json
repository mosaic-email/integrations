{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authenticated",
    "mid",
    "scope"
  ],
  "properties": {
    "authenticated": {
      "type": "boolean"
    },
    "mid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "scope": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
