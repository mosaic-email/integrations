{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "regionId", "sourceChecksum", "desktopWidthPx", "mobileWidthPx", "states"],
  "properties": {
    "schemaVersion": { "const": "mosaic-email-raster-plan-request-v1" },
    "regionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceChecksum": { "type": "string", "minLength": 71, "maxLength": 71 },
    "desktopWidthPx": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "mobileWidthPx": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["selectionKey", "sourceDigest", "empty"],
        "properties": {
          "selectionKey": { "type": "string", "minLength": 2, "maxLength": 32768 },
          "sourceDigest": { "type": "string", "minLength": 71, "maxLength": 71 },
          "empty": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
