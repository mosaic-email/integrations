{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lockidynamics/mosaic/blob/main/public/schemas/mosaic-package-release-v3.schema.json",
  "title": "Mosaic Package Release v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publisherKey",
    "packageKey",
    "catalogSlug",
    "version",
    "releaseDigest",
    "hostContract",
    "mosaicCompatibility",
    "compilerCompatibility",
    "artifacts",
    "interfaces",
    "capabilities",
    "contributions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 255
    },
    "schemaVersion": {
      "const": "mosaic-package-release-v3"
    },
    "publisherKey": {
      "$ref": "#/$defs/key"
    },
    "packageKey": {
      "$ref": "#/$defs/key"
    },
    "catalogSlug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "releaseDigest": {
      "$ref": "#/$defs/sha256"
    },
    "hostContract": {
      "const": "mosaic-package-host-v1"
    },
    "mosaicCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "maximumVersion"],
      "properties": {
        "minimumVersion": {
          "$ref": "#/$defs/semver"
        },
        "maximumVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "interfaces": {
      "$ref": "#/$defs/interfaces"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/contribution"
      }
    },
    "compilerCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion"],
      "properties": {
        "minimumVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "identity": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mediaType", "byteSize", "digest"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "kind": {
          "enum": ["ui", "worker", "wasm", "schema", "fixture", "connector"]
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputSchemaId", "resultSchemaId"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "inputSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "resultSchemaId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "dataRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaId", "mode", "maxBytes"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "schemaId": {
          "$ref": "#/$defs/identity"
        },
        "mode": {
          "enum": [
            "working-record",
            "immutable-version",
            "read-model",
            "artifact-metadata"
          ]
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "dataMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromSchemaId", "toSchemaId", "workerOperationId"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "fromSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "toSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "workerOperationId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiBridge", "worker", "data", "connectorJobs"],
      "properties": {
        "uiBridge": {
          "type": "null"
        },
        "worker": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "artifactPath", "operations"],
              "properties": {
                "version": {
                  "const": "mosaic-package-worker-v1"
                },
                "artifactPath": {
                  "$ref": "#/$defs/safePath"
                },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/operation"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sourceCodecIdentity",
            "retainedSourceCodecIdentities",
            "records",
            "migrations"
          ],
          "properties": {
            "version": {
              "const": "mosaic-package-data-v1"
            },
            "sourceCodecIdentity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "retainedSourceCodecIdentities": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "records": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/dataRecord"
              }
            },
            "migrations": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/dataMigration"
              }
            }
          }
        },
        "connectorJobs": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "operations"],
              "properties": {
                "version": {
                  "const": "mosaic-package-connector-job-v1"
                },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/operation"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "description",
        "requestedScope",
        "requestedClassification"
      ],
      "properties": {
        "schemaVersion": {
          "const": "mosaic-package-capabilities-v1"
        },
        "id": {
          "type": "string",
          "maxLength": 129,
          "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "requestedScope": {
          "enum": ["global", "library", "campaign", "asset", "review"]
        },
        "requestedClassification": {
          "enum": ["standard", "privileged"]
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "description",
        "requiredCapabilityId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "mosaic-package-contributions-v1"
        },
        "id": {
          "$ref": "#/$defs/identity"
        },
        "kind": {
          "enum": [
            "native-surface",
            "email-raster-region",
            "command",
            "governed-content-type",
            "read-model",
            "validator",
            "completion-target",
            "output",
            "artifact-kind",
            "preview-renderer",
            "asset-generator",
            "connector-operation"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "requiredCapabilityId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeVersion": {
          "const": "mosaic-package-native-contributions-v1"
        },
        "surface": {
          "enum": [
            "content-workspace",
            "builder-toolbar",
            "builder-inspector",
            "preview",
            "review"
          ]
        },
        "model": {
          "$ref": "#/$defs/nativeModel"
        },
        "modelOperation": {
          "$ref": "#/$defs/nativeOperationRef"
        },
        "commandOperation": {
          "$ref": "#/$defs/nativeOperationRef"
        },
        "evaluationOperation": {
          "$ref": "#/$defs/nativeOperationRef"
        },
        "dataReads": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "readId",
              "contributionId",
              "recordTypeId",
              "recordId"
            ],
            "properties": {
              "readId": {
                "$ref": "#/$defs/identity"
              },
              "contributionId": {
                "$ref": "#/$defs/identity"
              },
              "recordTypeId": {
                "$ref": "#/$defs/identity"
              },
              "recordId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
              }
            }
          }
        },
        "entryPoint": {
          "$ref": "#/$defs/safePath"
        },
        "operationId": {
          "$ref": "#/$defs/identity"
        },
        "inputSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "resultSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "sourceCodecIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "regionContract": {
          "const": "mosaic-email-raster-regions-v1"
        },
        "planContract": {
          "enum": ["mosaic-email-raster-plan-v1", "mosaic-email-raster-plan-v2"]
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "stageLabel", "reasons"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "stageLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "reasons": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": {
                    "enum": [
                      "EMAIL_RASTER_WORKER_FAILED",
                      "EMAIL_RASTER_WORKER_PLAN_INVALID"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "authoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "label",
            "accent",
            "icon",
            "controls",
            "brackets"
          ],
          "properties": {
            "schemaVersion": {
              "const": "mosaic-email-raster-authoring-v1"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "icon": {
              "enum": ["package", "image"]
            },
            "controls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": ["link", "alt"]
              }
            },
            "brackets": {
              "type": "boolean"
            }
          }
        },
        "artifactKind": {
          "$ref": "#/$defs/identity"
        },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "executionPlane": {
          "enum": ["worker", "connector-job"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "email-raster-region"
              }
            }
          },
          "then": {
            "required": [
              "regionContract",
              "sourceSchemaId",
              "operationId",
              "inputSchemaId",
              "resultSchemaId"
            ],
            "properties": {
              "requiredCapabilityId": {
                "$ref": "#/$defs/identity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sandbox-workspace"
              }
            }
          },
          "then": {
            "required": ["entryPoint"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "native-surface"
              }
            }
          },
          "then": {
            "required": ["nativeVersion", "surface", "model"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "read-model",
                  "validator",
                  "completion-target",
                  "output",
                  "preview-renderer",
                  "connector-operation"
                ]
              }
            }
          },
          "then": {
            "required": ["operationId", "inputSchemaId", "resultSchemaId"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "governed-content-type"
              }
            }
          },
          "then": {
            "required": ["sourceCodecIdentity", "sourceSchemaId"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "artifact-kind"
              }
            }
          },
          "then": {
            "required": ["artifactKind", "mediaTypes", "maxBytes"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "asset-generator"
              }
            }
          },
          "then": {
            "required": [
              "operationId",
              "executionPlane",
              "inputSchemaId",
              "resultSchemaId"
            ]
          }
        }
      ]
    },
    "nativeOperationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputSchemaId", "resultSchemaId"],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/identity"
        },
        "inputSchemaId": {
          "$ref": "#/$defs/identity"
        },
        "resultSchemaId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "nativeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "surface", "items"],
      "properties": {
        "schemaVersion": {
          "const": "mosaic-package-native-model-v1"
        },
        "surface": {
          "enum": [
            "content-workspace",
            "builder-toolbar",
            "builder-inspector",
            "preview",
            "review"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/nativeAction"
              },
              {
                "$ref": "#/$defs/nativeField"
              },
              {
                "$ref": "#/$defs/nativeProjection"
              }
            ]
          }
        }
      }
    },
    "nativeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "icon"],
      "properties": {
        "kind": {
          "const": "action"
        },
        "id": {
          "$ref": "#/$defs/identity"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "icon": {
          "enum": [
            "add",
            "edit",
            "delete",
            "duplicate",
            "image",
            "preview",
            "settings"
          ]
        },
        "commandId": {
          "$ref": "#/$defs/identity"
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "nativeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "control", "value"],
      "properties": {
        "kind": {
          "const": "field"
        },
        "id": {
          "$ref": "#/$defs/identity"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "control": {
          "enum": ["text", "number", "select", "switch", "date"]
        },
        "value": {},
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "commandId": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "nativeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "value", "tone"],
      "properties": {
        "kind": {
          "const": "projection"
        },
        "id": {
          "$ref": "#/$defs/identity"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "value": {},
        "tone": {
          "enum": ["neutral", "info", "success", "warning", "danger"]
        }
      }
    }
  }
}
