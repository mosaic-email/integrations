{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["hostContract", "releaseDigest", "regions"],
  "properties": {
    "hostContract": { "const": "mosaic-email-raster-regions-v1" },
    "releaseDigest": { "type": "string", "minLength": 71, "maxLength": 71 },
    "regions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "moduleInstanceIds", "stateOverrides"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "moduleInstanceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "stateOverrides": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["selection", "link"],
              "properties": {
                "selection": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "required": ["moduleInstanceId", "variationId"],
                    "properties": {
                      "moduleInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "variationId": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] }
                    },
                    "additionalProperties": false
                  }
                },
                "link": {
                  "oneOf": [
                    { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "auto" } }, "additionalProperties": false },
                    { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "none" } }, "additionalProperties": false },
                    { "type": "object", "required": ["kind", "url"], "properties": { "kind": { "const": "url" }, "url": { "type": "string", "minLength": 1, "maxLength": 4096 } }, "additionalProperties": false }
                  ]
                },
                "alt": { "type": "string", "maxLength": 2048 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
